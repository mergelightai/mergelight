  },
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://mergelight.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mergelightai/mergelight.git",
    "directory": "packages/mergelight"
  },
  "license": "FSL-1.1-MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
