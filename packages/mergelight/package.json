{
  "name": "@mergelight/cli",
  "version": "0.1.18",
  "description": "AI code review that runs on the Claude or ChatGPT plan you already pay for.",
  "type": "module",
  "bin": {
    "mergelight": "dist/cli.js"
  },
  "files": [
    "dist",
    "scripts",
    "skills",
    "templates"
  ],
  "scripts": {
